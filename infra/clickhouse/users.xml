<clickhouse>
    <profiles>
        <timeline_api>
            <readonly>1</readonly>
            <max_execution_time>5</max_execution_time>
            <max_result_rows>101</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
            <max_threads>8</max_threads>
            <do_not_merge_across_partitions_select_final>1</do_not_merge_across_partitions_select_final>
        </timeline_api>
        <timeline_ingest>
            <readonly>0</readonly>
            <max_threads>8</max_threads>
        </timeline_ingest>
    </profiles>
    <users>
        <api_ro>
            <password_sha256_hex from_env="CLICKHOUSE_API_PASSWORD_SHA256"/>
            <profile>timeline_api</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants><query from_env="CLICKHOUSE_API_GRANT"/></grants>
        </api_ro>
        <ingest_rw>
            <password_sha256_hex from_env="CLICKHOUSE_INGEST_PASSWORD_SHA256"/>
            <profile>timeline_ingest</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants><query from_env="CLICKHOUSE_INGEST_GRANT"/></grants>
        </ingest_rw>
    </users>
</clickhouse>
